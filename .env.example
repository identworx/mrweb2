# SQLite database path (use absolute path in production)
# Dev:        file:./dev.db
# Production: file:/var/www/clients/client1/web5/web/data/mosaroma.db
DATABASE_URL="file:./dev.db"

# Admin seed credentials
ADMIN_EMAIL="admin@mosaroma.de"
ADMIN_PASSWORD="changeme123"

# JWT secret for admin sessions — generate with: openssl rand -base64 32
ADMIN_JWT_SECRET="your-secret-key-here"

# SMTP configuration for email notifications (optional — submissions are saved even without SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Fallback recipient for contact form submissions (used when form has no recipientEmail)
CONTACT_FORM_RECIPIENT_FALLBACK=""
