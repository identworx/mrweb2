generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PageType {
  HOME
  STANDARD
  COLLECTION_INDEX
  COLLECTION_DETAIL
  MATERIAL_INDEX
  CATALOG_INDEX
  SERVICE
  NEWS_INDEX
  CONTACT
  LEGAL
}

enum SectionType {
  HERO
  TEXT
  IMAGE_TEXT
  CARD_GRID
  COLLECTION_GRID
  PRODUCT_GRID
  DOWNLOAD_GRID
  TECHNICAL_TABLE
  MEASUREMENT_TABLE
  CTA
  FAQ
  CONTACT_FORM
  CUSTOM
}

enum NavLocation {
  HEADER
  FOOTER
  SERVICE
  LEGAL
  MOBILE
}

enum FormFieldType {
  TEXT
  EMAIL
  PHONE
  TEXTAREA
  SELECT
  CHECKBOX
  RADIO
  FILE
  CONSENT
}

enum IconType {
  DEFAULT
  LIBRARY
  MEDIA
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id                    String      @id @default(cuid())
  siteName              String?
  logoDarkUrl           String?
  logoLightUrl          String?
  faviconUrl            String?
  logoMediaId           String?
  logoMedia             MediaAsset? @relation("SiteLogoImage", fields: [logoMediaId], references: [id], onDelete: SetNull)
  faviconMediaId        String?
  faviconMedia          MediaAsset? @relation("SiteFaviconImage", fields: [faviconMediaId], references: [id], onDelete: SetNull)
  primaryColor          String?
  secondaryColor        String?
  contactEmail          String?
  phone                 String?
  address               String?
  socialLinks           Json?
  defaultSeoTitle       String?
  defaultSeoDescription String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  path      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets MediaAsset[]
}

model MediaAsset {
  id            String   @id @default(cuid())
  filename      String
  originalName  String
  url           String
  normalizedUrl String?
  mimeType      String
  size          Int
  width         Int?
  height        Int?
  alt           String?
  title         String?
  caption       String?
  folder        String?
  folderId      String?
  mediaFolder   MediaFolder? @relation(fields: [folderId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Reverse relations
  siteLogos             SiteSettings[]   @relation("SiteLogoImage")
  siteFavicons          SiteSettings[]   @relation("SiteFaviconImage")
  footerLogos           FooterSettings[] @relation("FooterLogoImage")
  pageHeroImages        Page[]           @relation("PageHeroImage")
  pageSectionImages     PageSection[]  @relation("SectionImage")
  collectionHeroImages  Collection[]   @relation("CollectionHeroImage")
  collectionCardImages  Collection[]   @relation("CollectionCardImage")
  productGroupIcons     ProductGroup[] @relation("ProductGroupIcon")
  productGroupImages    ProductGroup[] @relation("ProductGroupImage")
  productHeroImages     Product[]      @relation("ProductHeroImage")
  productMainImages     Product[]      @relation("ProductMainImage")
  productImages         ProductImage[] @relation("ProductImageAsset")
  materialImages        Material[]     @relation("MaterialImage")
  downloadImages        Download[]     @relation("DownloadImage")
  newsHeroImages        NewsArticle[]  @relation("NewsHeroImage")
  newsCardImages        NewsArticle[]  @relation("NewsCardImage")
  measurementImages     Measurement[]  @relation("MeasurementImage")
  fabricSwatchImages    FabricSwatch[] @relation("FabricSwatchImage")
  ambienteImages        AmbienteImage[] @relation("AmbienteImageAsset")
  iconSlots             IconSlot[]
}

model NavigationMenu {
  id        String      @id @default(cuid())
  name      String
  location  NavLocation
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items NavigationItem[]
}

model NavigationItem {
  id           String   @id @default(cuid())
  menuId       String
  label        String
  linkType     String   @default("CUSTOM_URL")
  href         String?
  target       String   @default("_self")
  order        Int
  isActive     Boolean  @default(true)
  parentId     String?
  linkedPageId String?
  badgeText    String?
  badgeVariant String   @default("blue")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menu       NavigationMenu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent     NavigationItem? @relation("NavItemChildren", fields: [parentId], references: [id])
  children   NavigationItem[] @relation("NavItemChildren")
  linkedPage Page?           @relation(fields: [linkedPageId], references: [id], onDelete: SetNull)
}

model Page {
  id               String     @id @default(cuid())
  slug             String     @unique
  title            String
  eyebrow          String?
  headline         String?
  introText        String?
  heroImageId      String?
  status           PageStatus @default(DRAFT)
  type             PageType   @default(STANDARD)
  seoTitle         String?
  seoDescription   String?
  canonicalUrl     String?
  showInNavigation Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  heroImage       MediaAsset?      @relation("PageHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  sections        PageSection[]
  navigationItems NavigationItem[]
}

model PageSection {
  id          String      @id @default(cuid())
  pageId      String
  type        SectionType @default(CUSTOM)
  title       String?
  eyebrow     String?
  content     String?
  imageId     String?
  buttonLabel String?
  buttonHref  String?
  settings    Json?
  order       Int
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  page  Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  image MediaAsset? @relation("SectionImage", fields: [imageId], references: [id], onDelete: SetNull)
}

model Collection {
  id               String     @id @default(cuid())
  slug             String     @unique
  name             String
  number           Int?
  eyebrow          String?
  subtitle         String?
  shortDescription String?
  longDescription  String?
  heroImageId      String?
  cardImageId      String?
  moodColors       Json?
  fabric           String?
  status           PageStatus @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  order            Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  heroImage MediaAsset? @relation("CollectionHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  cardImage MediaAsset? @relation("CollectionCardImage", fields: [cardImageId], references: [id], onDelete: SetNull)
  products  Product[]
}

model ProductGroup {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  iconId      String?
  imageId     String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  icon     MediaAsset? @relation("ProductGroupIcon", fields: [iconId], references: [id], onDelete: SetNull)
  image    MediaAsset? @relation("ProductGroupImage", fields: [imageId], references: [id], onDelete: SetNull)
  products Product[]
}

model Product {
  id               String     @id @default(cuid())
  slug             String     @unique
  name             String
  collectionId     String
  productGroupId   String
  materialId       String?
  shortDescription String?
  description      String?
  code             String?
  size             String?
  colorName        String?
  patternName      String?
  features         Json?
  heroImageId      String?
  mainImageId      String?
  status           PageStatus @default(DRAFT)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  collection   Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productGroup ProductGroup  @relation(fields: [productGroupId], references: [id], onDelete: Cascade)
  material     Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)
  heroImage    MediaAsset?   @relation("ProductHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  mainImage    MediaAsset?   @relation("ProductMainImage", fields: [mainImageId], references: [id], onDelete: SetNull)
  images       ProductImage[]
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  mediaAssetId String?
  url          String?
  alt          String?
  order        Int
  isMain       Boolean  @default(false)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation("ProductImageAsset", fields: [mediaAssetId], references: [id], onDelete: SetNull)
}

model Material {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  subtitle         String?
  description      String?
  materialComp     String?
  weight           String?
  dyeing           String?
  comfort          String?
  cushionThickness String?
  highlights       Json?
  imageId          String?
  order            Int      @default(0)
  isActive         Boolean  @default(true)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  image    MediaAsset? @relation("MaterialImage", fields: [imageId], references: [id], onDelete: SetNull)
  products Product[]
}

model Measurement {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  groupSlug   String?
  drawingType String?
  imageId     String?
  imageAlt    String?
  variants    Json?
  notes       Json?
  sourceNote  String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image MediaAsset? @relation("MeasurementImage", fields: [imageId], references: [id], onDelete: SetNull)
}

model Download {
  id            String   @id @default(cuid())
  title         String
  description   String?
  type          String?
  fileUrl       String?
  externalUrl   String?
  language      String?
  imageId       String?
  buttonLabel   String?
  opensInNewTab Boolean  @default(false)
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  image MediaAsset? @relation("DownloadImage", fields: [imageId], references: [id], onDelete: SetNull)
}

model NewsArticle {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  eyebrow        String?
  excerpt        String?
  content        String?
  heroImageId    String?
  cardImageId    String?
  category       String?
  status         PageStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  heroImage MediaAsset? @relation("NewsHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  cardImage MediaAsset? @relation("NewsCardImage", fields: [cardImageId], references: [id], onDelete: SetNull)
}

model FooterSettings {
  id            String      @id @default(cuid())
  logoUrl       String?
  logoMediaId   String?
  logoMedia     MediaAsset? @relation("FooterLogoImage", fields: [logoMediaId], references: [id], onDelete: SetNull)
  description   String?
  copyrightText String?
  socialLinks   Json?

  // Footer CTA
  ctaEnabled        Boolean @default(false)
  ctaEyebrow        String?
  ctaTitle           String?
  ctaText            String?
  ctaPrimaryLabel   String?
  ctaPrimaryHref    String?
  ctaSecondaryLabel String?
  ctaSecondaryHref  String?

  // Contact
  contactTitle      String?
  companyName       String?
  addressLine1      String?
  addressLine2      String?
  postalCity        String?
  country           String?
  email             String?
  phone             String?
  contactButtonLabel String?
  contactButtonHref  String?

  // Bottom
  bottomNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Form {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  title          String?
  description    String?
  submitLabel    String?
  successMessage String?
  errorMessage   String?
  recipientEmail String?
  privacyText    String?
  honeypotField  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fields      FormField[]
  submissions FormSubmission[]
}

model FormField {
  id          String        @id @default(cuid())
  formId      String
  type        FormFieldType @default(TEXT)
  label       String
  placeholder String?
  name        String
  helpText    String?
  required    Boolean       @default(false)
  options     Json?
  order       Int
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  data      Json?
  meta      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Fabric Library
// ---------------------------------------------------------------------------

model FabricFamily {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  eyebrow          String?
  subtitle         String?
  material         String?
  weight           String?
  dyeing           String?
  comfort          String?
  cushionThickness String?
  hubHighlights    String?
  isHighlighted    Boolean  @default(false)
  order            Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  swatches FabricSwatch[]
}

model FabricSwatch {
  id            String   @id @default(cuid())
  familyId      String
  slug          String   @unique
  name          String
  articleNumber String?
  subtitle      String?
  description   String?
  swatchImageId String?
  colorHex      String?
  patternType             String?
  featuredOnMaterials     Boolean  @default(false)
  materialsPreviewOrder   Int?
  order                   Int      @default(0)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  family         FabricFamily        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  swatchImage    MediaAsset?         @relation("FabricSwatchImage", fields: [swatchImageId], references: [id], onDelete: SetNull)
  availabilities FabricAvailability[]
}

model FabricProductType {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  iconKey  String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  availabilities FabricAvailability[]
}

model FabricAvailability {
  id            String  @id @default(cuid())
  swatchId      String
  productTypeId String
  note          String?
  isAvailable   Boolean @default(true)

  swatch      FabricSwatch      @relation(fields: [swatchId], references: [id], onDelete: Cascade)
  productType FabricProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@unique([swatchId, productTypeId])
}

// ---------------------------------------------------------------------------
// Ambiente Gallery
// ---------------------------------------------------------------------------

model AmbienteImage {
  id           String     @id @default(cuid())
  title        String
  caption      String?
  alt          String?
  colorWorlds  Json?
  featured     Boolean    @default(false)
  teaserSlot   String?
  isActive     Boolean    @default(true)
  order        Int        @default(0)

  mediaAssetId String
  mediaAsset   MediaAsset @relation("AmbienteImageAsset", fields: [mediaAssetId], references: [id])

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// CMS Icon System
// ---------------------------------------------------------------------------

model IconSlot {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  groupName   String
  defaultIcon String
  iconType    IconType @default(DEFAULT)
  libraryIcon String?
  mediaId     String?
  sizeHint    String   @default("md")
  colorMode   String   @default("inherit")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
}

model ContentTranslation {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String   @default("")
  fieldName      String
  locale         String
  sourceText     String
  translatedText String
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([entityType, entityId, fieldName, locale])
  @@index([entityType, locale])
  @@index([entityType, entityId, locale])
}
